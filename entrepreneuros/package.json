{
  "name": "entrepreneuros",
  "version": "2.0.0",
  "description": "EntrepreneurOS v2 — Suite IA desktop pour entrepreneurs solos (10 modules, 3 modes IA)",
  "main": "main.js",
  "author": "EntrepreneurOS",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "cli": "node cli/index.js",
    "postinstall": "electron-builder install-app-deps",
    "build:mac": "electron-builder --mac dmg",
    "build:win": "electron-builder --win nsis",
    "build:all": "electron-builder -mwl",
    "mobile:init":   "npx cap add android",
    "mobile:sync":   "npx cap sync android",
    "mobile:open":   "npx cap open android",
    "mobile:build":  "cd android && ./gradlew assembleDebug",
    "mobile:apk":    "npm run mobile:sync && npm run mobile:build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "openai": "^4.90.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.8.0",
    "resend": "^3.5.0",
    "docx": "^8.5.0",
    "papaparse": "^5.4.1",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "marked": "^13.0.3"
  },
  "devDependencies": {
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.entrepreneuros.app",
    "productName": "EntrepreneurOS",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["**/*", "!data/**/*", "!Logo.png"],
    "extraResources": [{ "from": "build/icon.png", "to": "icon.png" }],
    "mac": { "category": "public.app-category.productivity", "target": "dmg", "icon": "build/icon.png" },
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "linux": { "target": "AppImage", "icon": "build/icon.png" }
  }
}
